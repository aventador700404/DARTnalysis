# ─────────────────────────────────────────────────────────────
# 데이터 파이프라인(pipeline/)용 환경변수
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 들어 있어서 GitHub에 올라가지 않습니다.
# ─────────────────────────────────────────────────────────────

# OpenDART 인증키 (40자리) — https://opendart.fss.or.kr  > 인증키 신청/관리
DART_API_KEY=

# 공공데이터포털 서비스키 — https://www.data.go.kr
#   "금융위원회_주식시세정보", "금융위원회_지수시세정보" 두 개 모두 활용신청 후
#   마이페이지에 보이는 "일반 인증키 (Decoding)" 값을 넣으세요.
DATAGOKR_SERVICE_KEY=

# 네이버 검색 API — https://developers.naver.com  > Application 등록 (검색 API 선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Supabase DB 연결 문자열 — 프로젝트 상단 [Connect] > "Session pooler" 의 URI
#   예) postgresql://postgres.xxxx:[비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
#   DB에 직접 쓰는 권한이라 절대 공개하지 마세요. (GitHub Actions에서는 Secrets에 저장)
SUPABASE_DB_URL=

# 하루 DART 호출 상한 (공식 한도 20,000건보다 낮게 잡아 여유 두기)
DART_DAILY_BUDGET=18000
