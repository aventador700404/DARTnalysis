# 웹(web/)용 환경변수 — 복사해서 .env.local 로 사용:  cp .env.example .env.local

# mock  : 저장소에 들어 있는 가상 기업 샘플 데이터로 실행 (키 없이 바로 실행 가능)
# supabase : 실제 데이터 (파이프라인으로 DB를 채운 뒤 사용)
DATA_SOURCE=mock

# DATA_SOURCE=supabase 일 때만 필요. anon 키는 읽기 전용(RLS)이라 브라우저에 노출돼도 됩니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
